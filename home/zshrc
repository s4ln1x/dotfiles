# =============================================================================
# OS detection
# =============================================================================
case "$OSTYPE" in
  darwin*) OS='macos' ;;
  linux*)  OS='linux' ;;
  *)      OS='other' ;;
esac

# =============================================================================
# PATH
# =============================================================================
typeset -U PATH path
if [[ "$OS" == "macos" ]] && [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/go/bin:$HOME/bin:$PATH"

# =============================================================================
# Environment
# =============================================================================
export EDITOR='vim'
export VISUAL='vim'
export PATH="$HOME/.npm-global/bin:$PATH"

# =============================================================================
# History
# =============================================================================
HISTFILE=~/.zsh_history
HISTSIZE=120000
SAVEHIST=100000
setopt SHARE_HISTORY         # share history across sessions
setopt HIST_IGNORE_DUPS      # drop consecutive duplicates only (safer with SHARE_HISTORY)
setopt HIST_EXPIRE_DUPS_FIRST # when trimming, drop dupes before uniques
setopt HIST_FIND_NO_DUPS      # skip repeated commands when searching history
setopt HIST_REDUCE_BLANKS    # trim extra whitespace
setopt HIST_VERIFY           # show !! expansions before running
setopt EXTENDED_HISTORY      # timestamp each entry

# =============================================================================
# Completion
# =============================================================================
autoload -Uz compinit
compinit
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # case-insensitive
zstyle ':completion:*' menu select                          # arrow-key menu

# =============================================================================
# Prompt — zsh's bundled vcs_info plus the installed Git command
# =============================================================================
autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:*' enable git
# The hook counts all states in one status scan instead of separate diff calls.
zstyle ':vcs_info:git:*' check-for-changes false
zstyle ':vcs_info:git:*' formats ' %F{76}%b%f%c%u'
zstyle ':vcs_info:git:*' actionformats ' %F{76}%b%f %F{196}(%a)%f%c%u'
zstyle ':vcs_info:git*+set-message:*' hooks git-prompt

function +vi-git-prompt() {
  # Branch names are data, including any literal prompt-format characters.
  hook_com[branch]=${hook_com[branch]//\%/%%}
  local git_output entry
  local -i staged=0 modified=0 untracked=0 conflicted=0 skip_original=0
  git_output=$(command git --no-optional-locks -C "$hook_com[base]" status \
    --porcelain=v2 -z --untracked-files=all --ignore-submodules=dirty \
    2>/dev/null) || return 0

  # NUL-separated records preserve spaces/newlines in filenames. Renames and
  # copies have an extra original-path record that must not be counted again.
  for entry in "${(@0)git_output}"; do
    if (( skip_original )); then
      skip_original=0
      continue
    fi
    case "$entry" in
      '1 '*|'2 '*)
        [[ $entry[3] != . ]] && (( ++staged ))
        [[ $entry[4] != . ]] && (( ++modified ))
        [[ $entry[1] == 2 ]] && skip_original=1
        ;;
      '? '*) (( ++untracked )) ;;
      'u '*) (( ++conflicted )) ;;
    esac
  done
  (( staged )) && hook_com[staged]=" %F{178}+${staged}%f"
  (( modified )) && hook_com[unstaged]=" %F{178}!${modified}%f"
  (( untracked )) && hook_com[unstaged]+=" %F{39}?${untracked}%f"
  (( conflicted )) && hook_com[unstaged]+=" %F{196}~${conflicted}%f"
  return 0
}

_native_prompt_precmd() {
  local command_status=$?
  vcs_info
  PROMPT="%F{31}%~%f${vcs_info_msg_0_}"$'\n'
  if (( command_status == 0 )); then
    PROMPT+='%F{76}❯%f '
  else
    PROMPT+='%F{196}❯%f '
  fi
}
setopt PROMPT_PERCENT
unsetopt PROMPT_SUBST
add-zsh-hook precmd _native_prompt_precmd
RPROMPT='%F{66}%D{%H:%M:%S}%f'

# =============================================================================
# Keyboard bindings
# =============================================================================
# Use non-modal command-line editing even when EDITOR/VISUAL is vim.
bindkey -e

# Home/End sequences used by tmux and common terminals.
bindkey '\e[1~' beginning-of-line
bindkey '\e[4~' end-of-line
bindkey '\e[H' beginning-of-line
bindkey '\e[F' end-of-line
bindkey '\eOH' beginning-of-line
bindkey '\eOF' end-of-line

# Up/down arrow — prefix history search (zsh built-in, instant)
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# =============================================================================
# fzf
# =============================================================================
if command -v fzf &>/dev/null; then
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
  if command -v fd &>/dev/null; then
    export FZF_CTRL_T_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  elif command -v fdfind &>/dev/null; then
    # Debian/Ubuntu package the binary as fdfind, not fd
    export FZF_CTRL_T_COMMAND='fdfind --type f --hidden --exclude .git'
    export FZF_ALT_C_COMMAND='fdfind --type d --hidden --exclude .git'
  fi

  # fzf 0.48+ generates its integration script; older packages provide files.
  if _fzf_init=$(fzf --zsh 2>/dev/null); then
    eval "$_fzf_init"
  else
    for _fzf_file in \
      /usr/share/fzf/shell/key-bindings.zsh \
      /usr/share/doc/fzf/examples/key-bindings.zsh \
      /usr/share/fzf/key-bindings.zsh \
      /opt/homebrew/opt/fzf/shell/key-bindings.zsh \
      /usr/local/opt/fzf/shell/key-bindings.zsh; do
      [[ -f "$_fzf_file" ]] && source "$_fzf_file" && break
    done
    for _fzf_file in \
      /usr/share/fzf/shell/completion.zsh \
      /usr/share/doc/fzf/examples/completion.zsh \
      /usr/share/fzf/completion.zsh \
      /opt/homebrew/opt/fzf/shell/completion.zsh \
      /usr/local/opt/fzf/shell/completion.zsh; do
      [[ -f "$_fzf_file" ]] && source "$_fzf_file" && break
    done
    unset _fzf_file
  fi
  unset _fzf_init
fi

# =============================================================================
# Functions (defined before the aliases that reference them)
# =============================================================================

# Upgrade a Fedora/RHEL system fully. Does NOT power off — add `&& sudo
# systemctl poweroff` at the call site if you want that, or run `dnfup-shutdown`.
dnf_up() {
  sudo dnf -y upgrade || return
  sudo dnf -y distro-sync || return
  sudo dnf -y autoremove || return
  if command -v rpmconf &>/dev/null; then
    sudo rpmconf -a || return
  fi
  if command -v flatpak &>/dev/null; then
    flatpak update -y || return
  fi
  return 0
}

dnf_up_shutdown() {
  dnf_up && sudo systemctl poweroff
}

# =============================================================================
# Aliases — general
# =============================================================================
alias tree='tree -C'
alias grep='grep --color=auto'
alias sshx='ssh -Y'
alias vim='vim -p'
alias nvim='nvim -p'

# =============================================================================
# Aliases — OS-specific
# =============================================================================
if [[ "$OS" == "macos" ]]; then
  alias ls='ls -G'
  alias ll='ls -lahG'
  alias la='ls -AG'
  alias brewup='brew update && brew upgrade && brew cleanup'

elif [[ "$OS" == "linux" ]]; then
  alias ls='ls --color=auto'
  alias ll='ls -lah --color=auto'
  alias la='ls -A --color=auto'

  # Package-manager aliases — only defined where the tool exists
  if command -v dnf &>/dev/null; then
    alias dnfup=dnf_up
    alias dnfup-shutdown=dnf_up_shutdown
  fi

  if command -v pacman &>/dev/null; then
    alias pacman-autoremove='pacman -Qdtq | xargs -r sudo pacman -Rsn'
  fi
fi

# =============================================================================
# Work overrides — after defaults, before the final widget plugins
# =============================================================================
[[ -f "$HOME/.zshrc_work" ]] && source "$HOME/.zshrc_work"

# =============================================================================
# Optional packaged plugins — syntax highlighting must follow every widget
# =============================================================================
_find_plugin() {
  local name="$1" candidate
  local candidates=(
    "/opt/homebrew/share/$name/$name.zsh"
    "/opt/homebrew/share/$name/$name.plugin.zsh"
    "/usr/local/share/$name/$name.zsh"
    "/usr/local/share/$name/$name.plugin.zsh"
    "/usr/share/$name/$name.zsh"
    "/usr/share/$name/$name.plugin.zsh"
    "/usr/share/zsh/plugins/$name/$name.zsh"
    "/usr/share/zsh/plugins/$name/$name.plugin.zsh"
    "/usr/share/zsh/site-contrib/$name.zsh"
  )
  for candidate in $candidates; do
    [[ -r "$candidate" ]] && { print -r -- "$candidate"; return 0 }
  done
  return 1
}

for _plugin_name in zsh-autosuggestions zsh-syntax-highlighting; do
  _plugin_path=$(_find_plugin "$_plugin_name") && source "$_plugin_path"
done
unset -f _find_plugin
unset _plugin_name _plugin_path
