# =============================================================================
# Powerlevel10k instant prompt — must stay near the top
# =============================================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =============================================================================
# OS detection
# =============================================================================
case "$(uname -s)" in
  Darwin) OS='macos' ;;
  Linux)  OS='linux' ;;
  *)      OS='other' ;;
esac

# =============================================================================
# PATH
# =============================================================================
if [[ "$OS" == "macos" ]] && [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/go/bin:$HOME/bin:$PATH"

# =============================================================================
# Environment
# =============================================================================
export EDITOR='vim'
export VISUAL='vim'
export PATH="$HOME/.npm-global/bin:$PATH"

# =============================================================================
# History
# =============================================================================
HISTFILE=~/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000
setopt SHARE_HISTORY         # share history across sessions
setopt HIST_IGNORE_DUPS      # drop consecutive duplicates only (safer with SHARE_HISTORY)
setopt HIST_EXPIRE_DUPS_FIRST # when trimming, drop dupes before uniques
setopt HIST_REDUCE_BLANKS    # trim extra whitespace
setopt HIST_VERIFY           # show !! expansions before running
setopt EXTENDED_HISTORY      # timestamp each entry

# =============================================================================
# Completion
# =============================================================================
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # case-insensitive
zstyle ':completion:*' menu select                          # arrow-key menu

# =============================================================================
# Plugins — find and source wherever the distro puts them
# =============================================================================
_find_plugin() {
  local name="$1"
  local candidates=(
    # macOS (Homebrew Apple Silicon)
    "/opt/homebrew/share/$name/$name.zsh"
    "/opt/homebrew/share/$name/$name.plugin.zsh"
    # macOS (Homebrew Intel)
    "/usr/local/share/$name/$name.zsh"
    "/usr/local/share/$name/$name.plugin.zsh"
    # Fedora, RHEL, Oracle, Debian, Ubuntu, openSUSE
    "/usr/share/$name/$name.zsh"
    "/usr/share/$name/$name.plugin.zsh"
    # Arch
    "/usr/share/zsh/plugins/$name/$name.zsh"
    "/usr/share/zsh/plugins/$name/$name.plugin.zsh"
    # openSUSE fallback
    "/usr/share/zsh/site-contrib/$name.zsh"
  )
  for candidate in $candidates; do
    [[ -f "$candidate" ]] && { echo "$candidate"; return 0 }
  done
  return 1
}

_find_p10k() {
  local candidates=(
    "/opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme"
    "/usr/local/share/powerlevel10k/powerlevel10k.zsh-theme"
    "/usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme"
    "$HOME/.local/share/powerlevel10k/powerlevel10k.zsh-theme"
  )
  for candidate in $candidates; do
    [[ -f "$candidate" ]] && { echo "$candidate"; return 0 }
  done
  return 1
}

# Theme first, then autosuggestions, then syntax-highlighting LAST
_p10k_path=$(_find_p10k) && source "$_p10k_path"
_plugin_path=$(_find_plugin "zsh-autosuggestions") && source "$_plugin_path"
_plugin_path=$(_find_plugin "zsh-syntax-highlighting") && source "$_plugin_path"

unset -f _find_plugin _find_p10k
unset _p10k_path _plugin_path

[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# =============================================================================
# Up/down arrow — prefix history search (zsh built-in, instant)
# =============================================================================
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# =============================================================================
# fzf
# =============================================================================
if command -v fzf &>/dev/null; then
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
  if command -v fd &>/dev/null; then
    export FZF_CTRL_T_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  elif command -v fdfind &>/dev/null; then
    # Debian/Ubuntu package the binary as fdfind, not fd
    export FZF_CTRL_T_COMMAND='fdfind --type f --hidden --exclude .git'
    export FZF_ALT_C_COMMAND='fdfind --type d --hidden --exclude .git'
  fi

  # `fzf --zsh` needs fzf 0.48+ (Feb 2024). Older distros (Debian stable,
  # RHEL 9, Oracle Linux, Leap) ship older fzf — fall back to sourcing the
  # key-bindings and completion files directly from whatever path the distro
  # uses.
  if fzf --zsh &>/dev/null; then
    source <(fzf --zsh)
  else
    for _fzf_file in \
      /usr/share/fzf/shell/key-bindings.zsh \
      /usr/share/doc/fzf/examples/key-bindings.zsh \
      /usr/share/fzf/key-bindings.zsh \
      /opt/homebrew/opt/fzf/shell/key-bindings.zsh \
      /usr/local/opt/fzf/shell/key-bindings.zsh; do
      [[ -f "$_fzf_file" ]] && source "$_fzf_file" && break
    done
    for _fzf_file in \
      /usr/share/fzf/shell/completion.zsh \
      /usr/share/doc/fzf/examples/completion.zsh \
      /usr/share/fzf/completion.zsh \
      /opt/homebrew/opt/fzf/shell/completion.zsh \
      /usr/local/opt/fzf/shell/completion.zsh; do
      [[ -f "$_fzf_file" ]] && source "$_fzf_file" && break
    done
    unset _fzf_file
  fi
fi

# =============================================================================
# Functions (defined before the aliases that reference them)
# =============================================================================

# Upgrade a Fedora/RHEL system fully. Does NOT power off — add `&& sudo
# systemctl poweroff` at the call site if you want that, or run `dnfup-shutdown`.
dnf_up() {
  sudo dnf -y upgrade
  sudo dnf -y distro-sync
  sudo dnf -y autoremove
  command -v rpmconf &>/dev/null && sudo rpmconf -a
  command -v flatpak &>/dev/null && flatpak update -y
}

dnf_up_shutdown() {
  dnf_up && sudo systemctl poweroff
}

# =============================================================================
# Aliases — general
# =============================================================================
alias tree='tree -C'
alias grep='grep --color=auto'
alias ssh='ssh -Y'
alias vim='vim -p'
alias nvim='nvim -p'

# =============================================================================
# Aliases — OS-specific
# =============================================================================
if [[ "$OS" == "macos" ]]; then
  alias ls='ls -G'
  alias ll='ls -lahG'
  alias la='ls -AG'
  alias brewup='brew update && brew upgrade && brew cleanup'

elif [[ "$OS" == "linux" ]]; then
  alias ls='ls --color=auto'
  alias ll='ls -lah --color=auto'
  alias la='ls -A --color=auto'
  alias htop='TERM=xterm-color htop'

  # Package-manager aliases — only defined where the tool exists
  if command -v dnf &>/dev/null; then
    alias dnfup=dnf_up
    alias dnfup-shutdown=dnf_up_shutdown
  fi

  if command -v pacman &>/dev/null; then
    alias pacman-autoremove='pacman -Qdtq | xargs -r sudo pacman -Rsn'
  fi
fi

# =============================================================================
# Work overrides — sourced LAST so it can override anything above
# =============================================================================
[[ -f "$HOME/.zshrc_work" ]] && source "$HOME/.zshrc_work"
